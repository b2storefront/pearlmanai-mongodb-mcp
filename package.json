{
  "name": "pearlmanai-mongodb-mcp",
  "version": "0.1.0",
  "description": "PearlmanAI financial reports MCP — whole-report lookups from an isolated MongoDB database",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npx fastmcp inspect src/index.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "ensure-schema": "tsx src/schema.ts",
    "validate": "tsx src/validate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^3.32.0",
    "mongodb": "^6.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
