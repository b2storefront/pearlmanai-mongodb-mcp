# MongoDB — already-imported per-property parsed-report databases on the Atlas cluster.
# The MCP user needs read on those databases (1050, 1705, 1850, 2606, 455, 4633, 530, 9810, Corbett, Timbers).
# MDB_MCP_CONNECTION_STRING is also accepted (legacy MongoDB MCP env name).
MONGODB_URI=mongodb+srv://USER:PASSWORD@pearlmanai.d2kqlae.mongodb.net/

# Transport
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8008

# Auth — production sits behind nginx API-key auth, so MCP_AUTH=none there.
# For a direct HTTP test: MCP_AUTH=api_key and MCP_API_KEY.
MCP_AUTH=none
MCP_API_KEY=
